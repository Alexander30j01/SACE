# Copia este archivo con el nombre .env en esta misma carpeta (C:\Proyectos\sace)
# El archivo .env NO se sube a GitHub: tiene contraseñas.
PORT=3000

# PostgreSQL (lo usa backend/src/Infraestructura/database/postgres/conexion.js)
PG_DATABASE=sace_db
PG_USER=postgres
PG_PASSWORD=tu_contraseña
PG_HOST=localhost
PG_PORT=5432

# MongoDB (lo usa backend/src/Infraestructura/database/mongo/conexion.js)
MONGO_URI=mongodb://127.0.0.1:27017/sace_db
